# Copy to .env on the server and fill in. Never commit .env.

# Database password (long random string)
DB_PASSWORD=change-me

# Signs login sessions. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Session: access token minutes, and idle sign-out after N minutes without activity
ACCESS_TOKEN_MINUTES=15
SESSION_IDLE_MINUTES=30

# Failed sign-in lockout
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Attachment size limit
MAX_UPLOAD_MB=5

# Backups (used by deploy/backup.sh)
BACKUP_DIR=/var/backups/vbt-accounts
BACKUP_PASSPHRASE=change-me
BACKUP_KEEP_DAYS=30
# Optional off-server copy, e.g. "gdrive:vbt-accounts-backups" (needs rclone configured)
BACKUP_REMOTE=
